{
  "$schema": "../schema/flattening.schema.json",
  "target": "env",
  "description": "How the Content object of a Storyteller configuration becomes environment variables (format env, and the variables sform exports). Each vector has a name, the document (the Content object) and either the variables with their values or the error that makes it invalid. A variable's name is the steps to the value upper-cased (ToUpperInvariant) and joined with __, an array item by its index: DB__HOSTS__0. Values are the raw text, as in flattening/flat.json, before the quoting of a .env file. A property name must match [A-Za-z0-9.-]+(_[A-Za-z0-9.-]+)*, and a name of the root object must start with an ASCII letter (invalid-env-name). The base rules of flattening/flat.json apply first, then invalid-env-name over every property name; the first error is reported. Error paths are those of flattening/flat.json. Numbers are read as double-precision floats. formats.json pins the quoting of the file.",
  "vectors": [
    {
      "name": "study example",
      "document": {
        "db": {
          "host": "db.internal",
          "port": 5432,
          "hosts": [ "db-1", "db-2" ],
          "ssl": true
        },
        "features": {
          "beta": false,
          "ratio": 0.5
        },
        "Logging": {
          "LogLevel": {
            "Default": "Information"
          }
        },
        "name": "billing"
      },
      "keys": {
        "DB__HOST": "db.internal",
        "DB__PORT": "5432",
        "DB__HOSTS__0": "db-1",
        "DB__HOSTS__1": "db-2",
        "DB__SSL": "true",
        "FEATURES__BETA": "false",
        "FEATURES__RATIO": "0.5",
        "LOGGING__LOGLEVEL__DEFAULT": "Information",
        "NAME": "billing"
      }
    },
    {
      "name": "an empty document has no keys",
      "document": {},
      "keys": {}
    },
    {
      "name": "strings stay as written",
      "document": {
        "empty": "",
        "padded": " padded ",
        "date": "2026-10-20T12:00:00.1230000+02:00",
        "binding": "@kv(\"db-password\")",
        "booleanText": "True",
        "numberText": "05432",
        "unicode": "Žluťoučký kůň"
      },
      "keys": {
        "EMPTY": "",
        "PADDED": " padded ",
        "DATE": "2026-10-20T12:00:00.1230000+02:00",
        "BINDING": "@kv(\"db-password\")",
        "BOOLEANTEXT": "True",
        "NUMBERTEXT": "05432",
        "UNICODE": "Žluťoučký kůň"
      }
    },
    {
      "name": "numbers are their JSON text",
      "document": {
        "integer": 5432,
        "negative": -7,
        "zero": 0,
        "fraction": 0.5,
        "negativeFraction": -0.25,
        "trailingZero": 1.50
      },
      "keys": {
        "INTEGER": "5432",
        "NEGATIVE": "-7",
        "ZERO": "0",
        "FRACTION": "0.5",
        "NEGATIVEFRACTION": "-0.25",
        "TRAILINGZERO": "1.5"
      }
    },
    {
      "name": "numbers that are not safe integers are their double text",
      "document": {
        "large": 1E+20,
        "huge": 1.7976931348623157E+308,
        "tiny": 5E-324,
        "small": 1.5E-07,
        "tenThousandth": 0.0001,
        "hundredThousandth": 0.00001,
        "fraction": 123456.789,
        "longFraction": 1000000000000000.5,
        "sum": 0.30000000000000004,
        "maxSafe": 9007199254740991,
        "minSafe": -9007199254740991
      },
      "keys": {
        "LARGE": "1E+20",
        "HUGE": "1.7976931348623157E+308",
        "TINY": "5E-324",
        "SMALL": "1.5E-07",
        "TENTHOUSANDTH": "0.0001",
        "HUNDREDTHOUSANDTH": "1E-05",
        "FRACTION": "123456.789",
        "LONGFRACTION": "1000000000000000.5",
        "SUM": "0.30000000000000004",
        "MAXSAFE": "9007199254740991",
        "MINSAFE": "-9007199254740991"
      }
    },
    {
      "name": "booleans are lower case",
      "document": {
        "on": true,
        "off": false
      },
      "keys": {
        "ON": "true",
        "OFF": "false"
      }
    },
    {
      "name": "null makes no key",
      "document": {
        "a": null,
        "b": { "c": null },
        "d": [ null ]
      },
      "keys": {}
    },
    {
      "name": "empty objects and arrays make no key",
      "document": {
        "a": {},
        "b": [],
        "c": { "d": {}, "e": [ [] ] }
      },
      "keys": {}
    },
    {
      "name": "array items keep their index, also after a null",
      "document": {
        "list": [ "x", null, "z", { "name": "w" }, [ "nested" ] ]
      },
      "keys": {
        "LIST__0": "x",
        "LIST__2": "z",
        "LIST__3__NAME": "w",
        "LIST__4__0": "nested"
      }
    },
    {
      "name": "names keep their casing and their dots, spaces and dashes",
      "document": {
        "Db": { "ConnectionString": "Server=db" },
        "a.b": "1",
        "c d": "2",
        "e-f": "3"
      },
      "error": { "rule": "invalid-env-name", "path": "$['c d']" }
    },
    {
      "name": "sections whose names differ only in case merge",
      "document": {
        "Db": { "Host": "a" },
        "db": { "port": 1 }
      },
      "keys": {
        "DB__HOST": "a",
        "DB__PORT": "1"
      }
    },
    {
      "name": "a value and a section may share a name",
      "document": {
        "a": "x",
        "A": { "b": "y" }
      },
      "keys": {
        "A": "x",
        "A__B": "y"
      }
    },
    {
      "name": "a colon in a name is invalid",
      "document": {
        "db": { "a:b": "x" }
      },
      "error": { "rule": "colon-in-name", "path": "$.db['a:b']" }
    },
    {
      "name": "a colon in the name of a null is invalid too",
      "document": {
        "a:b": null
      },
      "error": { "rule": "colon-in-name", "path": "$['a:b']" }
    },
    {
      "name": "an empty name is invalid",
      "document": {
        "db": { "": "x" }
      },
      "error": { "rule": "empty-name", "path": "$.db['']" }
    },
    {
      "name": "keys that differ only in case are invalid",
      "document": {
        "Db": { "Host": "a" },
        "db": { "host": "b" }
      },
      "error": { "rule": "case-collision", "path": "$.db.host" }
    },
    {
      "name": "an array item and a property that differ only in case are invalid",
      "document": {
        "list": [ "x" ],
        "LIST": { "0": "y" }
      },
      "error": { "rule": "case-collision", "path": "$.LIST['0']" }
    },
    {
      "name": "names with quotes are escaped in paths",
      "document": {
        "it's": { "a:b": 1 }
      },
      "error": { "rule": "colon-in-name", "path": "$['it\\'s']['a:b']" }
    },
    {
      "name": "control characters are escaped in paths",
      "document": {
        "x\n::warning::y": "z"
      },
      "error": { "rule": "colon-in-name", "path": "$['x\\n::warning::y']" }
    },
    {
      "name": "a hash is escaped in paths",
      "document": {
        "##[warning]x:y": "z"
      },
      "error": { "rule": "colon-in-name", "path": "$['\\u0023\\u0023[warning]x:y']" }
    },
    {
      "name": "a dotless i and an I are different names",
      "document": { "I": 1, "ı": 2 },
      "error": { "rule": "invalid-env-name", "path": "$['ı']" }
    },
    {
      "name": "a long s and an s are different names",
      "document": { "s": 1, "ſ": 2 },
      "error": { "rule": "invalid-env-name", "path": "$['ſ']" }
    },
    {
      "name": "letters beyond the Basic Multilingual Plane that differ only in case collide",
      "document": { "𐐀": 1, "𐐨": 2 },
      "error": { "rule": "case-collision", "path": "$['𐐨']" }
    },
    {
      "name": "Greek letters with ypogegrammeni that differ only in case collide",
      "document": { "ᾳ": 1, "ᾼ": 2 },
      "error": { "rule": "case-collision", "path": "$['ᾼ']" }
    },
    {
      "name": "an unpaired surrogate becomes U+FFFD",
      "document": { "note": "x\ud800y" },
      "keys": { "NOTE": "x\ufffdy" }
    },
    {
      "name": "the document must be an object",
      "document": [ "a", "b" ],
      "error": { "rule": "not-an-object", "path": "$" }
    },
    {
      "name": "dots and dashes are kept",
      "document": {
        "Logging": { "LogLevel": { "Microsoft.AspNetCore": "Warning" } },
        "my-app": { "retry-count": 3 }
      },
      "keys": {
        "LOGGING__LOGLEVEL__MICROSOFT.ASPNETCORE": "Warning",
        "MY-APP__RETRY-COUNT": "3"
      }
    },
    {
      "name": "a single _ between other characters is kept",
      "document": {
        "db_main": { "max_pool_size": 10 }
      },
      "keys": {
        "DB_MAIN__MAX_POOL_SIZE": "10"
      }
    },
    {
      "name": "a space in a name is invalid",
      "document": {
        "a b": "x"
      },
      "error": { "rule": "invalid-env-name", "path": "$['a b']" }
    },
    {
      "name": "a space in the name of a null is invalid too",
      "document": {
        "a b": null
      },
      "error": { "rule": "invalid-env-name", "path": "$['a b']" }
    },
    {
      "name": "a quote in a name is invalid",
      "document": {
        "db": { "it's": "x" }
      },
      "error": { "rule": "invalid-env-name", "path": "$.db['it\\'s']" }
    },
    {
      "name": "a name of the root must start with a letter",
      "document": {
        "0a": 1
      },
      "error": { "rule": "invalid-env-name", "path": "$['0a']" }
    },
    {
      "name": "a nested name may start with a digit",
      "document": {
        "a": { "0b": 1 }
      },
      "keys": {
        "A__0B": "1"
      }
    },
    {
      "name": "__ inside a name is invalid",
      "document": {
        "a__b": 1
      },
      "error": { "rule": "invalid-env-name", "path": "$.a__b" }
    },
    {
      "name": "a leading _ is invalid",
      "document": {
        "a": { "_b": 1 }
      },
      "error": { "rule": "invalid-env-name", "path": "$.a._b" }
    },
    {
      "name": "a trailing _ is invalid",
      "document": {
        "a_": 1
      },
      "error": { "rule": "invalid-env-name", "path": "$.a_" }
    },
    {
      "name": "non-ASCII letters are invalid",
      "document": {
        "čas": 1
      },
      "error": { "rule": "invalid-env-name", "path": "$['čas']" }
    },
    {
      "name": "the first invalid name in document order is reported",
      "document": {
        "ok": { "x y": 1 },
        "0a": 2
      },
      "error": { "rule": "invalid-env-name", "path": "$.ok['x y']" }
    },
    {
      "name": "an object binding of an effective document is invalid",
      "document": {
        "retries": {
          "$binding": "jlogic",
          "$definition": { "if": [ { "<": [ { "var": "tier" }, 2 ] }, 1, 5 ] },
          "$context": { "tier": "@config(\"/plan/tier\")" }
        }
      },
      "error": { "rule": "invalid-env-name", "path": "$.retries['$binding']" }
    }
  ]
}
