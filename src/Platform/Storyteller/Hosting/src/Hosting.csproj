<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Hosting</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.Sdk.Hosting</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <Description>Hosting for 2S Platform Storyteller in .NET: who am I (the annotation of STORYTELLER_KEY and its ancestors) and the catalog of executions, over the settings, credentials and transport of the configuration provider.</Description>
    <PackageTags>$(PackageTags);platform;2S;storyteller;configuration;hosting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="42.Platform.Storyteller.Hosting.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings the SDK and Abstractions.Annotations; Hosting uses internals of it, so both ship one version. -->
    <ProjectReference Include="..\..\Configuration\src\Configuration.csproj" />
  </ItemGroup>

</Project>
