<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Configuration.KeyVault</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.Sdk.Configuring.KeyVault</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <Description>Resolves the secret references of 2S Platform Storyteller configurations (kv:// shorthands, Key Vault secret URIs and App Configuration references) in Azure Key Vault, locally, with the application's own identity.</Description>
    <PackageTags>$(PackageTags);platform;2S;storyteller;configuration;keyvault;secrets</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="42.Platform.Storyteller.Configuration.KeyVault.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Configuration\src\Configuration.csproj" />
  </ItemGroup>

</Project>
