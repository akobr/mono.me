<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Configuration.UnitTests</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.Sdk.Configuring.UnitTests</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The conformance suite, shared with the providers and SDKs of other languages; embedded so the tests read it
         without the file system. RecursiveDir holds the separator of the OS, which ConformanceFiles normalizes. -->
    <EmbeddedResource Include="..\..\conformance\**\*.json" LogicalName="Conformance/%(RecursiveDir)%(Filename)%(Extension)" Link="Conformance\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />

    <!-- Only to validate the conformance files against their schemas. -->
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.TestingHelpers" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Libraries\Testing\System.IO.Abstractions.Trace\src\System.IO.Abstractions.Trace.csproj" />
    <ProjectReference Include="..\src\Configuration.csproj" />
  </ItemGroup>

</Project>
