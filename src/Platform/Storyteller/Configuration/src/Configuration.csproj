<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Configuration</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.Sdk.Configuring</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <Description>Configuration provider that loads a 2S Platform Storyteller configuration into IConfiguration, polls it with If-None-Match, keeps a last-known-good cache and switches the active key at runtime.</Description>
    <PackageTags>$(PackageTags);platform;2S;storyteller;configuration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="42.Platform.Storyteller.Configuration.UnitTests" />

    <!-- Hosting builds on the settings, transport, classification and documents of the provider; both ship one version. -->
    <InternalsVisibleTo Include="42.Platform.Storyteller.Hosting" />
    <InternalsVisibleTo Include="42.Platform.Storyteller.Hosting.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="TestableIO.System.IO.Abstractions" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions.Annotations\src\Abstractions.Annotations.csproj" />
    <ProjectReference Include="..\..\ConfigurationFormats\src\ConfigurationFormats.csproj" />
    <ProjectReference Include="..\..\Sdk.NSwag\src\Sdk.NSwag.csproj" />
  </ItemGroup>

</Project>
