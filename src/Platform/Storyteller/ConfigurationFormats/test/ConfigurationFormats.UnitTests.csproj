<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.ConfigurationFormats.UnitTests</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.ConfigurationFormats.UnitTests</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The conformance suite, shared with the providers and SDKs of other languages; embedded so the tests read it
         without the file system. RecursiveDir holds the separator of the OS, which ConformanceFiles normalizes. -->
    <EmbeddedResource Include="..\..\conformance\**\*.json" LogicalName="Conformance/%(RecursiveDir)%(Filename)%(Extension)" Link="Conformance\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!-- Only to check that the YAML the library writes parses back; the library itself has no YAML dependency. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\ConfigurationFormats.csproj" />
  </ItemGroup>

</Project>
