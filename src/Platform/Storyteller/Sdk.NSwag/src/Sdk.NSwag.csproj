<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Sdk.NSwag</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.Sdk</RootNamespace>

    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <Description>C# client of the 2S Platform Storyteller API, generated by NSwag, with conditional reads of configurations, machine credentials (API key, certificate, client credentials, workload identity federation, token file) and an opt-in resilience pipeline.</Description>
    <PackageTags>$(PackageTags);platform;2S;storyteller;sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="42.Platform.Storyteller.Sdk.NSwag.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="TestableIO.System.IO.Abstractions" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\KeyValues.ClientEncryption\src\KeyValues.ClientEncryption.csproj" />
  </ItemGroup>

</Project>
