<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Api.Functions</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.Api</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <UserSecretsId>07aec5a9-3cdc-41e5-aebc-ea5d7bea33ae</UserSecretsId>
    <_FunctionsSkipCleanOutput>true</_FunctionsSkipCleanOutput>
    <DockerFastModeProjectMountDirectory>/home/site/wwwroot</DockerFastModeProjectMountDirectory>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..\..\..</DockerfileContext>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);DEV_AUTH</DefineConstants>
  </PropertyGroup>

  <!-- A Debug build (DEV_AUTH) skips the checks of users: it is never published, so it never reaches a deployment, also not one
       the startup guard cannot recognize (a VM, plain Docker, Container Instances). -p:AllowDevelopmentAuthenticationPublish=true
       publishes one anyway, for a local container only. -->
  <Target Name="RefuseDevelopmentAuthenticationPublish" BeforeTargets="PrepareForPublish" Condition="$(DefineConstants.Contains('DEV_AUTH')) And '$(AllowDevelopmentAuthenticationPublish)' != 'true'">
    <Error Code="STORYTELLER001" Text="DEV_AUTH: a Debug build of the Storyteller API skips the checks of users and is never published. Publish with -c Release." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="42.Platform.Storyteller.Api.Functions.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.OpenApi" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" />
    <PackageReference Include="Microsoft.Azure.WebJobs.Extensions.OpenApi.Core" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Sentry.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Access.ApiKeys\src\Access.ApiKeys.csproj" />
    <ProjectReference Include="..\..\Access.AuthKit\src\Access.AuthKit.csproj" />
    <ProjectReference Include="..\..\Access.Certificates\src\Access.Certificates.csproj" />
    <ProjectReference Include="..\..\Access.Certificates.Azure.KeyVault\src\Access.Certificates.Azure.KeyVault.csproj" />
    <ProjectReference Include="..\..\Access.AzureAd\src\Access.AzureAd.csproj" />
    <ProjectReference Include="..\..\Access.Federation\src\Access.Federation.csproj" />
    <ProjectReference Include="..\..\Access.Keycloak\src\Access.Keycloak.csproj" />
    <ProjectReference Include="..\..\Backend.AzureStorage\src\Backend.AzureStorage.csproj" />
    <ProjectReference Include="..\..\Backend.CosmosDb\src\Backend.CosmosDb.csproj" />
    <ProjectReference Include="..\..\Binding.Azure.KeyVault\src\Binding.Azure.KeyVault.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Platform\Storyteller\ConfigurationFormats\src\ConfigurationFormats.csproj" />
    <ProjectReference Include="..\..\KeyValues.Azure.KeyVault\src\KeyValues.Azure.KeyVault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="local.settings.azure-entra.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="local.settings.authkit.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
