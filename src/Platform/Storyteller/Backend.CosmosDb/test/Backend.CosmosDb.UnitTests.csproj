<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Backend.CosmosDb.UnitTests</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.Backend.CosmosDb.UnitTests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 on Microsoft.Testing.Platform: the tests are an executable, and 'dotnet run' takes the options of 'dotnet test'. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Testcontainers.CosmosDb" />
    <PackageReference Include="Testcontainers.LowkeyVault" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Binding.Azure.KeyVault\src\Binding.Azure.KeyVault.csproj" />
    <ProjectReference Include="..\..\Binding.Core\src\Binding.Core.csproj" />
    <ProjectReference Include="..\..\DbCreator\src\DbCreator.csproj" />
    <ProjectReference Include="..\..\KeyValues.Azure.KeyVault\src\KeyValues.Azure.KeyVault.csproj" />
    <ProjectReference Include="..\src\Backend.CosmosDb.csproj" />
  </ItemGroup>

</Project>
