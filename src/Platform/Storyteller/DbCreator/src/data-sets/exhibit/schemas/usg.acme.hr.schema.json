{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToonDayHR",
  "description": "ToonDayHR must track survival and say how employees are put back together.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application",
    "hr"
  ],
  "properties": {
    "application": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "ToonDayHR"
        },
        "version": {
          "$ref": "#/definitions/binding"
        },
        "url": {
          "$ref": "#/definitions/binding"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hr": {
      "type": "object",
      "required": [
        "survivalTracking",
        "reconstitution"
      ],
      "additionalProperties": false,
      "properties": {
        "leave": {
          "type": "object",
          "properties": {
            "bonusDays": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "Reconstitution leave."
            }
          }
        },
        "survivalTracking": {
          "type": "object",
          "required": [
            "enabled",
            "livesPerEmployee"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "livesPerEmployee": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "resetCycle": {
              "enum": [
                "per-episode",
                "per-season",
                "never"
              ]
            }
          }
        },
        "reconstitution": {
          "type": "object",
          "required": [
            "methods",
            "maxPerDay"
          ],
          "properties": {
            "methods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "accordion-shake",
                  "inflate-with-bicycle-pump",
                  "peel-off-the-pavement",
                  "reassemble-from-ashes"
                ]
              }
            },
            "maxPerDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "requiresForm": {
              "type": "string"
            }
          }
        },
        "physicsCompliance": {
          "type": "object",
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auditEveryDays": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "reviews": {
          "type": "object",
          "properties": {
            "frequency": {
              "enum": [
                "annual",
                "quarterly",
                "after-every-incident"
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "binding": {
      "type": "string",
      "pattern": "^@"
    }
  }
}
