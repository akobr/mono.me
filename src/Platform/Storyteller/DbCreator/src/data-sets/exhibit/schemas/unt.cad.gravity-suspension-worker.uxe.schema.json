{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A JobInstance of GravitySuspensionWorker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job"
  ],
  "properties": {
    "job": {
      "type": "object",
      "required": [
        "scan",
        "suspend"
      ],
      "additionalProperties": false,
      "properties": {
        "batch": {
          "type": "string"
        },
        "scan": {
          "type": "object",
          "required": [
            "objects",
            "minWeightKg"
          ],
          "properties": {
            "objects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "anvil",
                  "piano",
                  "safe",
                  "boulder",
                  "cow"
                ]
              }
            },
            "minWeightKg": {
              "type": "integer",
              "minimum": 1
            },
            "ledgeProximityCm": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "$ref": "#/definitions/binding"
                }
              ]
            },
            "intervalSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "#/definitions/binding"
                }
              ]
            }
          }
        },
        "suspend": {
          "type": "object",
          "required": [
            "until"
          ],
          "properties": {
            "vector": {
              "const": "down"
            },
            "until": {
              "const": "user_looked_down"
            },
            "hangTimeMs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "$ref": "#/definitions/binding"
                }
              ]
            }
          }
        },
        "reportTo": {
          "$ref": "#/definitions/binding"
        }
      }
    },
    "physics": {
      "type": "object",
      "properties": {
        "gravity": {
          "enum": [
            "on",
            "optional",
            "disabled",
            "suspended-until-looked-down"
          ]
        }
      }
    }
  },
  "definitions": {
    "binding": {
      "type": "string",
      "pattern": "^@"
    }
  }
}
