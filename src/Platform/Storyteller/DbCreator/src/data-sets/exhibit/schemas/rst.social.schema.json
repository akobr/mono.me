{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Social",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "social"
  ],
  "properties": {
    "social": {
      "type": "object",
      "required": [
        "channels",
        "messages"
      ],
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "object",
          "properties": {
            "defaults": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^#[a-z0-9-]+$"
              }
            },
            "maxPerUser": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "messages": {
          "type": "object",
          "required": [
            "retentionDays"
          ],
          "properties": {
            "retentionDays": {
              "type": "integer",
              "minimum": 1
            },
            "editWindowMinutes": {
              "type": "integer",
              "minimum": 0
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40000
            }
          }
        },
        "gifs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "provider": {
              "enum": [
                "giphy",
                "tenor",
                "hand-drawn"
              ]
            },
            "rating": {
              "enum": [
                "g",
                "pg",
                "pg-13"
              ]
            }
          }
        },
        "presence": {
          "type": "object",
          "properties": {
            "idleAfterMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "moderation": {
          "type": "object",
          "properties": {
            "profanityFilter": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
