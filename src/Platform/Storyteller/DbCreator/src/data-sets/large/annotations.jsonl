// The built-in set large: the shape of the admin UI mock's large dataset (app/mock/annotations.ts, npm run dev:mock --
// --large) without its random choices. Six responsibilities with their units, then 500 subjects, each with the
// contexts prod and staging, a usage of every responsibility, an execution per usage and context, and a unit of
// execution per unit in prod: 17 + 500 x 32 = 16 017 annotations. The relation arrays stay small: a subject lists 2
// contexts and 6 responsibilities, nothing lists the 500 subjects.
//
// The responsibilities and their units.
{"AnnotationKey":"rst.invoicing","Title":"Invoicing","Description":"Issues the invoices of the customers.","Labels":["billing"]}
{"AnnotationKey":"unt.invoicing.pdf","Title":"Invoice PDF","UnitType":"file","UnitDefinition":"invoice.pdf"}
{"AnnotationKey":"unt.invoicing.email","Title":"Invoice e-mail","UnitType":"message","UnitDefinition":"invoice-issued"}
{"AnnotationKey":"rst.payments","Title":"Payments","Description":"Collects the payments of the invoices.","Labels":["billing","pci"]}
{"AnnotationKey":"unt.payments.card","Title":"Card payments","UnitType":"event","UnitDefinition":"card-captured"}
{"AnnotationKey":"unt.payments.sepa","Title":"SEPA direct debits","UnitType":"time","UnitDefinition":"0 6 * * 1-5"}
{"AnnotationKey":"rst.reporting","Title":"Reporting","Description":"Exports the reports of the month."}
{"AnnotationKey":"unt.reporting.csv","Title":"CSV export","UnitType":"file","UnitDefinition":"report.csv"}
{"AnnotationKey":"unt.reporting.xlsx","Title":"Excel export","UnitType":"file","UnitDefinition":"report.xlsx"}
{"AnnotationKey":"rst.notifications","Title":"Notifications","Description":"Tells the customers what happened."}
{"AnnotationKey":"unt.notifications.sms","Title":"SMS","UnitType":"message","UnitDefinition":"notification-sms"}
{"AnnotationKey":"unt.notifications.email","Title":"E-mail","UnitType":"message","UnitDefinition":"notification-email"}
{"AnnotationKey":"unt.notifications.push","Title":"Push notification","UnitType":"message","UnitDefinition":"notification-push"}
{"AnnotationKey":"rst.archiving","Title":"Archiving","Description":"Keeps the documents for their retention period.","Labels":["gdpr"]}
{"AnnotationKey":"unt.archiving.s3","Title":"S3 archive","UnitType":"time","UnitDefinition":"0 2 * * *"}
{"AnnotationKey":"rst.dunning","Title":"Dunning","Description":"Reminds the customers of unpaid invoices."}
{"AnnotationKey":"unt.dunning.letter","Title":"Reminder letter","UnitType":"file","UnitDefinition":"reminder.pdf"}
//
// The subjects customer-001 to customer-500 and their contexts.
{"$count":500,"AnnotationKey":"sbt.customer-{000}","Title":"Customer {n}","Labels":["generated"],"Values":{"customerNumber":"C-{00000}"}}
