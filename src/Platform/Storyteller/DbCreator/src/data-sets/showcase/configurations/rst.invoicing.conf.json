{
  "baseCurrency": "EUR",
  "retryPolicy": {
    "attempts": 5,
    "backoffSeconds": 60
  },
  "features": [
    "pdf",
    "email",
    "credit-notes",
    "e-invoice"
  ],
  "email": {
    "host": "@smtp.host",
    "sender": "@smtp.sender",
    "password": "@(smtp.password, secret)"
  },
  "pdfRenderer": "@pdf.rendererUrl"
}
