<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Abstractions.Annotations</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog of project settings, shared with the conformance suite and the SDKs (ProjectSettingsCatalog). -->
    <EmbeddedResource Include="..\..\conformance\project-settings.json" LogicalName="_42.Platform.Storyteller.project-settings.json" Link="Catalog\project-settings.json" />
  </ItemGroup>

</Project>
