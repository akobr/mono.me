<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.Binding.JsonE.UnitTests</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.Binding.JsonE.UnitTests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 on Microsoft.Testing.Platform: the tests are an executable, and 'dotnet run' takes the options of 'dotnet test'. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="YamlDotNet" />

    <!-- The unpatched upstream binary, only for parity checks against the vendored fork. -->
    <PackageReference Include="JsonE.Net" Aliases="upstream" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Binding.JsonE.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Specification\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
