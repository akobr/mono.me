# Copy to .env.local for local overrides.
VITE_API_BASE_URL=http://localhost:7071/api
# Custom AuthKit domain; required on every host except localhost.
VITE_AUTH_API_HOSTNAME=
VITE_ENVIRONMENT_NAME=local
# Telemetry, off when missing; never in the e2e mode (dev:mock, Playwright) or in unit tests.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.de.sentry.io/<project>
# VITE_POSTHOG_PROJECT_TOKEN=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
