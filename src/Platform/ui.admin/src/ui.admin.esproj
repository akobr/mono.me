<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <JavaScriptTestRoot>test\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Vitest</JavaScriptTestFramework>
    <!-- dotnet build src must not require Node; opt in with -p:BuildJavaScript=true -->
    <ShouldRunNpmInstall Condition="'$(BuildJavaScript)' != 'true'">false</ShouldRunNpmInstall>
    <ShouldRunBuildScript Condition="'$(BuildJavaScript)' != 'true'">false</ShouldRunBuildScript>
    <BuildCommand>npm run build</BuildCommand>
    <PublishAssetsDirectory>$(MSBuildProjectDirectory)\dist</PublishAssetsDirectory>
    <!-- The SDK sets TargetPlatformIdentifier=None, which NuGet of the .NET 10 SDK rejects (NU1012: net6.0-none). -->
    <TargetPlatformIdentifier />
    <TargetPlatformMoniker />
  </PropertyGroup>

  <!-- The SDK's GeneratePackageJsonProps task writes '$(IntermediateOutputPath)\package.g.props' as it is, so on Linux and
       macOS the restore creates a folder literally named 'obj\Debug', and the '**' globs of the traversals then return their
       pattern instead of the projects ('dotnet build src': MSB3202). A normalized path keeps the file in obj/Debug/.
       A checkout restored before this target has such a folder already, one per configuration: delete them once
       (rm -rf 'obj\Debug' 'obj\Release' here). -->
  <Target Name="_NormalizePackagePropsPath" BeforeTargets="GeneratePackageJsonProps">
    <PropertyGroup>
      <PackagePropsPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'package.g.props'))</PackagePropsPath>
    </PropertyGroup>
  </Target>
</Project>
