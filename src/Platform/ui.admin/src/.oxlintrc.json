{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "app/typed-router.d.ts",
    "app/auto-imports.d.ts",
    "app/components.d.ts"
  ],
  "rules": {
    "unicorn/consistent-function-scoping": "off"
  }
}
