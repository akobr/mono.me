{
  // The committed defaults; docs/Platform/UI.Admin.AutomationTests/automation-tests.md ("Configure") lists every
  // layer above them. No secrets here: passwords and keys go to the user secrets (or UITESTS_* variables in CI).
  // Without Target:BaseUrl every test is skipped, so the solution's dotnet test passes without a running admin UI; the
  // dev profile (UITESTS_PROFILE=dev) targets the local dev server (npm run dev / Aspire, port 5173).
  "Target": {
    "BaseUrl": "",
    "Organization": "ui-tests",
    "Project": "automation",
    "View": "default",
    "SignIn": "AuthKit",
    "MockScenario": null,
    "EmailDomain": "example.com",
    // { "<Role>": "<org>/<project>[/<view>]" }: a project where every pool user holds the role, for the tests of that
    // role ([UserRole]); a role without an entry leases a pool user who holds it in Target:Project.
    "RoleProjects": {},
    // How long a wait for an answer of the API may take: two reads in a row at the admin UI's 30 s read timeout, plus
    // a margin, so that a stalled request ends in the UI's error state, which the wait reports.
    "ApiTimeoutMs": 65000,
    // The same for a write (a save's toast, Bulk create's result): a write at the admin UI's 120 s write timeout, then
    // the two reads with which a configuration save that timed out reads its content again, plus a margin.
    "ApiWriteTimeoutMs": 185000
  },
  "Browser": {
    "Provider": "Local",
    "Engine": "chromium",
    "Channel": null,
    "Headless": true,
    "SlowMoMs": 0,
    "Device": null,
    "Viewport": { "Width": 1440, "Height": 900 },
    "Locale": "en-US",
    "TimeZone": "Europe/Prague",
    "ColorScheme": "light"
  },
  "Execution": {
    "MaxParallelTests": 4,
    "Seed": null,
    "ActionTimeoutMs": 10000,
    "NavigationTimeoutMs": 30000,
    "ExpectTimeoutMs": 10000,
    "Retries": 0,
    "Trace": "OnFailure",
    "Screenshot": "OnFailure",
    "Video": "Off",
    "ArtifactsPath": "TestResults/artifacts"
  },
  "Users": {
    "LeaseTimeoutSeconds": 120,
    // The pre-provisioned AuthKit users of the automation (their roles in the target's organization and project); the
    // passwords are in the user secrets (Users:Pool:<n>:Password) or UITESTS_Users__Pool__<n>__Password. Passwords pair
    // with the users by position: reordering the list means moving the secrets with it.
    "Pool": [
      { "Email": "ui-test-owner-1@42for.software", "DisplayName": "Auto Owner1", "Roles": [ "Owner" ] },
      { "Email": "ui-test-owner-2@42for.software", "DisplayName": "Auto Owner2", "Roles": [ "Owner" ] },
      { "Email": "ui-test-admin-1@42for.software", "DisplayName": "Auto Admin1", "Roles": [ "Administrator" ] },
      { "Email": "ui-test-admin-2@42for.software", "DisplayName": "Auto Admin2", "Roles": [ "Administrator" ] },
      { "Email": "ui-test-contributor-1@42for.software", "DisplayName": "Auto Contributor1", "Roles": [ "Contributor" ] },
      { "Email": "ui-test-contributor-2@42for.software", "DisplayName": "Auto Contributor2", "Roles": [ "Contributor" ] },
      { "Email": "ui-test-reader-1@42for.software", "DisplayName": "Auto Reader1", "Roles": [ "Reader" ] },
      { "Email": "ui-test-reader-2@42for.software", "DisplayName": "Auto Reader2", "Roles": [ "Reader" ] }
    ]
  },
  "BrowserStack": {
    "Username": "",
    "AccessKey": "",
    "Endpoint": "wss://cdp.browserstack.com/playwright",
    "Project": "2S Platform - admin UI",
    "Build": null,
    "BuildTag": null,
    "Os": "Windows",
    "OsVersion": "11",
    "Browser": "chrome",
    "BrowserVersion": "latest",
    "Resolution": "1920x1080",
    "Local": false,
    "LocalIdentifier": null,
    "PlaywrightVersion": null,
    "SessionPerTest": true,
    "Console": "errors",
    "NetworkLogs": false,
    "Debug": false,
    "Video": true,
    "MaskCommands": "sendType, sendPress, setHTTPCredentials, setStorageState",
    "PlaywrightLogs": false,
    "MaxParallelSessions": 5,
    "ConnectTimeoutSeconds": 300,
    "AdditionalCapabilities": {}
  },
  // The purge of the automation data of earlier runs (Tests/Maintenance, the category Maintenance): off, so nothing is
  // deleted unless a run asks for it with --test-parameter Maintenance:Purge=true (or UITESTS_Maintenance__Purge=true).
  // It deletes the roots of the target's view named like generated data (at-<runId>-…) of other runs, created more than
  // OlderThanHours ago, then purges such deleted roots, and starts no request after BudgetSeconds.
  "Maintenance": {
    "Purge": false,
    "OlderThanHours": 72,
    "BudgetSeconds": 120
  },
  "Reporting": {
    "Enabled": false,
    "Systems": [],
    "RunName": "UI automation {Date:yyyy-MM-dd} {Time:HH:mm} {Profile}",
    "RunDescription": null,
    "UnmappedTests": "Ignore",
    "BatchSize": 20,
    "FlushIntervalSeconds": 5,
    "MaxAttempts": 5,
    "CompleteTimeoutSeconds": 120,
    "ReplayFile": null
  }
}
