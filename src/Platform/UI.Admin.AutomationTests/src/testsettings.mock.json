{
  // The admin UI's mock build (npm run dev:mock in src/Platform/ui.admin/src, port 5174): MSW serves the API in the
  // browser and Ada Lovelace is signed in, so there is no sign-in and no password. ?mock-scenario=default on the first
  // navigation of each test starts every test from the default dataset (acme / billing / default).
  "Target": {
    "BaseUrl": "http://localhost:5174",
    "Organization": "acme",
    "Project": "billing",
    "View": "default",
    "SignIn": "None",
    "MockScenario": "default",
    // Where the tests of an exact role act ([UserRole(Role.Contributor)], [UserRole(Role.Reader)]): the projects of the
    // default dataset where Ada Lovelace, whom every pool user stands for, holds exactly that role. acme/shipping keeps
    // her Owner role of the organization acme; northwind/portal has no organization role.
    "RoleProjects": {
      "Contributor": "acme/shipping",
      "Reader": "northwind/portal"
    }
  },
  "Execution": {
    // The dev server serves the app unbundled: with 4 parallel tests a page load in Firefox takes about 10 s (a cold
    // Firefox start more than the default 30 s) and the first render after it up to 6 s, near the default 10 s. A
    // deployed (bundled) build needs no more than the defaults.
    "NavigationTimeoutMs": 60000,
    "ExpectTimeoutMs": 15000
  },
  "Users": {
    // Placeholders: with SignIn None the pool only bounds the parallelism. Each stands for Ada Lovelace, the Owner of
    // acme and acme/billing in the default dataset, so a test that requires an Owner or an editing role gets any of
    // them.
    "Pool": [
      { "Email": "mock-user-1@example.com", "Roles": [ "Owner" ] },
      { "Email": "mock-user-2@example.com", "Roles": [ "Owner" ] },
      { "Email": "mock-user-3@example.com", "Roles": [ "Owner" ] },
      { "Email": "mock-user-4@example.com", "Roles": [ "Owner" ] }
    ]
  }
}
