{
  // The admin UI's mock build (npm run dev:mock in src/Platform/ui.admin/src, port 5174): MSW serves the API in the
  // browser and Ada Lovelace is signed in, so there is no sign-in and no password. ?mock-scenario=default on the first
  // navigation of each test starts every test from the default dataset (acme / billing / default).
  "Target": {
    "BaseUrl": "http://localhost:5174",
    "Organization": "acme",
    "Project": "billing",
    "View": "default",
    "SignIn": "None",
    "MockScenario": "default"
  },
  "Users": {
    // Placeholders: with SignIn None the pool only bounds the parallelism.
    "Pool": [
      { "Email": "mock-user-1@example.com" },
      { "Email": "mock-user-2@example.com" },
      { "Email": "mock-user-3@example.com" },
      { "Email": "mock-user-4@example.com" }
    ]
  }
}
