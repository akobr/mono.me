<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Crumble.Playground.Examples</AssemblyName>
    <RootNamespace>_42.Crumble.Playground.Examples</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Runtime.Orleans\src\Runtime.Orleans.csproj" />
    <!-- Build dependency only -->
    <ProjectReference Include="..\..\Examples.Crumble\src\Examples.Crumble.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Examples.Crumble\src\*.cs" />
  </ItemGroup>

  <!-- The files the Crumble source generator emits into the obj of Examples.Crumble exist only after that project has
       built, so they are collected after the project references are built, not by a static glob that a clean build
       evaluates before they exist. -->
  <Target Name="IncludeCrumbleGeneratedFiles" AfterTargets="ResolveProjectReferences" BeforeTargets="BeforeCompile;CompileDesignTime">
    <ItemGroup>
      <Compile Remove="..\..\Examples.Crumble\src\obj\Generated\42.Crumble.SourceGenerator*\**\*.cs" />
      <Compile Include="..\..\Examples.Crumble\src\obj\Generated\42.Crumble.SourceGenerator*\**\*.cs" AutoGen="true" />
    </ItemGroup>
  </Target>

</Project>
