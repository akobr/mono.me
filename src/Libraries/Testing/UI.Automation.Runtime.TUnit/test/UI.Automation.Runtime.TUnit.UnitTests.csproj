<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Testing.UI.Automation.Runtime.TUnit.UnitTests</AssemblyName>
    <RootNamespace>_42.Testing.UI.Automation.Runtime.TUnit.UnitTests</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- An xUnit project: TUnit.Core comes with the library under test, its global usings are not wanted here. -->
    <TUnitImplicitUsings>false</TUnitImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 on Microsoft.Testing.Platform: the tests are an executable, and 'dotnet run' takes the options of 'dotnet test'. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\UI.Automation.Runtime.TUnit.csproj" />
  </ItemGroup>

</Project>
