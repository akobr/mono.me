<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Testing.UI.Automation.Reporting.Testiny</AssemblyName>
    <RootNamespace>_42.Testing.UI.Automation.Reporting.Testiny</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <Description>Testiny reporter of the 42 UI automation framework: a classic Testiny test run whose test cases are the [TestCase] ids of the tests, with the aggregated result of each case, markdown comments with duration, environment and stack trace, and the screenshots, traces and logs of failed tests as attachments.</Description>
    <PackageTags>$(PackageTags);testing;ui;automation;testiny</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="42.Testing.UI.Automation.Reporting.Testiny.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="TestableIO.System.IO.Abstractions" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UI.Automation.Abstractions\src\UI.Automation.Abstractions.csproj" />
  </ItemGroup>

</Project>
