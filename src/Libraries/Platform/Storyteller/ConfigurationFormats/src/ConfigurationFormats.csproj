<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>42.Platform.Storyteller.ConfigurationFormats</AssemblyName>
    <RootNamespace>_42.Platform.Storyteller.ConfigurationFormats</RootNamespace>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <Description>Renders 2S Platform Storyteller configurations as flat JSON (IConfiguration keys), Spring Boot properties, .env files and YAML, with the flattening rules and the validation of the .NET configuration provider.</Description>
    <PackageTags>$(PackageTags);platform;2S;storyteller;configuration;properties;dotenv;yaml</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
