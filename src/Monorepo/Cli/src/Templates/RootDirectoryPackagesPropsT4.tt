<#@ template language="C#" linePragmas="false" #>
<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>

    <!-- Please create any groups of dependencies if you need -->
    <!-- <PackageVersion Include="package-name" Version="package-version" /> -->

    <!-- abstractions for .NET libraries -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />

    <!-- .NET libraries -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />

    <!-- unit testing -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
<# if (_featureProvider.IsEnabled("tests-tunit")) { #>
    <PackageVersion Include="TUnit" Version="1.78.0" />
<# } #><# if (_featureProvider.IsEnabled("tests-xunit")) { #>
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
<# } #><# if (_featureProvider.IsEnabled("tests-nunit")) { #>
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
<# } #><# if (_featureProvider.IsEnabled("git-version")) { #>

    <!-- versioning -->
    <PackageVersion Include="42.Monorepo.GitVersioning" Version="1.2.3" />
<# } #>

    <!-- code analysis -->
<# if (_featureProvider.IsEnabled("stylecop")) { #>
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.151-beta" />
<# } #><# if (_featureProvider.IsEnabled("sonar")) { #>
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
<# } #>
  </ItemGroup>
</Project>
