{
  "$schema":
    "https://raw.githubusercontent.com/AArnott/Nerdbank.GitVersioning/master/src/NerdBank.GitVersioning/version.schema.json",
  "version": "0.1.0",
  "publicReleaseRefSpec": [
    "^refs/heads/main$" // we release only out of main
  ],
  "cloudBuild": {
    // off: every project wrote GitBuildVersion* to $GITHUB_ENV, and parallel build nodes overwrote each other's lines,
    // which failed the step after its tests passed (424-310); nothing reads the variables
    "setVersionVariables": false,
    "buildNumber": {
      "enabled": true,
      "includeCommitId": {
        "when": "nonPublicReleaseOnly",
        "where": "buildMetadata"
      }
    }
  }
}
